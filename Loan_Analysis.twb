                            <groupfilter function='level-members' level='[Education]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                        </worksheet>
                      </capturedDeltas>
                    </story-point>
                    <story-point caption='The majority of loans were disbursed to self-employed individuals, with the lowest age group being 18-27, where self-employed individuals accounted for 55.21% of the total loan amount.' captured-sheet='Loan Vs Income Analysis ' id='3'>
                      <capturedDeltas>
                        <worksheet name='Income By Education'>
                          <filter class='categorical' column='[federated.12nipjj1i3w28v14qn73b0he7jkn].[Action (Employment Type)]'>
