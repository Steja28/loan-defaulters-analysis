                <flipboard active-id='2' nav-type='caption' show-nav-arrows='true'>
                  <story-points>
                    <story-point caption='Between the ages of 38 and 47, a significant number of loans were obtained by individuals who are self-employed and hold a bachelor&apos;s degree. However, full-time employees in this age group have the highest income.' captured-sheet='Loan Vs Income Analysis ' id='2'>
                      <capturedDeltas>
                        <worksheet name='Income by Employment'>
                          <filter class='categorical' column='[federated.12nipjj1i3w28v14qn73b0he7jkn].[Action (Education)]'>
                            <groupfilter function='level-members' level='[Education]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                        </worksheet>
                        <worksheet name='Loan Distribution by Age'>
                          <filter class='categorical' column='[federated.12nipjj1i3w28v14qn73b0he7jkn].[Action (Education)]'>
                            <groupfilter function='level-members' level='[Education]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                          <filter class='categorical' column='[federated.12nipjj1i3w28v14qn73b0he7jkn].[none:Age (bin):ok]'>
                            <groupfilter function='member' level='[none:Age (bin):ok]' member='3' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
                          </filter>
                        </worksheet>
